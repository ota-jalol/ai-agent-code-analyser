# Nemotron 3 nano AI Model Configuration
# Configure these settings to enable AI-powered agent management

# Nemotron API Endpoint (default: http://localhost:8000)
# For NVIDIA AI Endpoints, use: https://integrate.api.nvidia.com/v1
NEMOTRON_API_ENDPOINT=http://localhost:8000

# Nemotron API Key (required for AI features)
# Get your API key from: https://build.nvidia.com/
NEMOTRON_API_KEY=your_api_key_here

# Model Configuration (optional)
# NEMOTRON_MODEL_NAME=nemotron-3-nano
# NEMOTRON_TEMPERATURE=0.7
# NEMOTRON_MAX_TOKENS=2048
